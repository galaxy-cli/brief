#!/usr/bin/env python3
import cmd
import sqlite3
import subprocess
import sys
import datetime
import os

try:
    import feedparser
    from newspaper import Article
except ImportError:
    print("Error: Missing dependencies. Run 'pip install feedparser newspaper3k'")
    sys.exit(1)

DB_FILENAME = "news.db" 
TTS_SCRIPT = os.path.expanduser("~/.local/bin/ftts")

class BriefShell(cmd.Cmd):
    prompt = "(Brief) "

    def __init__(self):
        super().__init__()
        self.last_list = []      
        self.last_rss_list = []  
        self.conn = sqlite3.connect(DB_FILENAME, isolation_level=None)
        self.conn.row_factory = sqlite3.Row
        
        self.conn.execute("CREATE TABLE IF NOT EXISTS rss_feeds (id INTEGER PRIMARY KEY, url TEXT UNIQUE)")
        self.conn.execute("CREATE TABLE IF NOT EXISTS article (id INTEGER PRIMARY KEY, url TEXT UNIQUE, title TEXT, content TEXT, source TEXT, fetched_date TEXT, publish_date TEXT)")
        
        self.refresh_article_list()
        self.refresh_rss_list()

    def query(self, sql, params=()):
        with self.conn:
            return self.conn.execute(sql, params)

    def refresh_article_list(self):
        self.last_list = [r['id'] for r in self.query("SELECT id FROM article ORDER BY publish_date ASC").fetchall()]

    def refresh_rss_list(self):
        self.last_rss_list = [r['id'] for r in self.query("SELECT id FROM rss_feeds ORDER BY url ASC").fetchall()]

    def _resolve_indices(self, id_str, target_list):
        if id_str == "*":
            return target_list
        
        resolved_indices = []
        for part in id_str.replace(',', ' ').split():
            try:
                if '-' in part:
                    start, end = map(int, part.split('-'))
                    if start <= end:
                        resolved_indices.extend(range(start, end + 1))
                else:
                    resolved_indices.append(int(part))
            except ValueError: 
                continue

        return [target_list[idx - 1] for idx in resolved_indices if 0 < idx <= len(target_list)]

    def parse_ids(self, id_str):
        return self._resolve_indices(id_str, self.last_list)

    def parse_feed_ids(self, id_str):
        return self._resolve_indices(id_str, self.last_rss_list)

    def delete_items(self, table, id_str):
        if table not in ["article", "rss_feeds"]:
            return
            
        ids = self.parse_ids(id_str) if table == "article" else self.parse_feed_ids(id_str)
        if not ids: 
            print("No valid IDs identified for deletion.")
            return
            
        print(f"Deleting IDs from {table}: {ids}")
        if input("Confirm? [y/N] ").lower() == 'y':
            placeholders = ','.join(['?'] * len(ids))
            self.query(f"DELETE FROM {table} WHERE id IN ({placeholders})", ids)
            self.refresh_article_list() if table == "article" else self.refresh_rss_list()

    @staticmethod
    def parse_date(src):
        for attr in ['published_parsed', 'publish_date', 'published']:
            val = getattr(src, attr, None)
            if not val: 
                continue
            try:
                if hasattr(val, 'tm_year'):
                    return datetime.date(val.tm_year, val.tm_mon, val.tm_mday)
                if isinstance(val, datetime.datetime):
                    return val.date()
                if isinstance(val, str):
                    return datetime.date.fromisoformat(val[:10])
            except (ValueError, TypeError): 
                continue
        return None

    def article_summary(self, a, ui_index):
        site = "unknown"
        if a['source'] and '//' in a['source']:
            parts = a['source'].split('/')
            if len(parts) > 2:
                site = parts[2].replace("www.", "")
        
        date_str = f"({a['publish_date']}) " if a['publish_date'] else ""
        return f"{ui_index}. {a['title']} {date_str}[{site}]"

    def save_article(self, url, source_url=None):
        try:
            if self.query("SELECT 1 FROM article WHERE url=?", (url,)).fetchone():
                return

            art = Article(url)
            art.download()  
            art.parse()
            
            extracted_date = self.parse_date(art)
            pub_date_str = extracted_date.isoformat() if extracted_date else None

            self.query("""INSERT INTO article 
                (url, title, content, source, publish_date) 
                VALUES (?, ?, ?, ?, ?)""", 
                (url, art.title, art.text, source_url or url, pub_date_str))
            
            print(f"  + Saved: {art.title[:50]}...")
            self.refresh_article_list()
            
        except Exception as e:
            print(f"  ! Failed to parse {url}: {e}")
  

    def do_rss(self, arg):
        """Commands: rss [list|add URL|fetch NUM NUM|- NUM]"""
        parts = arg.split()
        if not parts:
            return
        
        cmd = parts[0]
        args = parts[1:]

        if cmd == "list":
            rows = self.query("SELECT * FROM rss_feeds ORDER BY url ASC").fetchall()
            if not rows:
                print("No feeds found in the database.")
                return
            for i, r in enumerate(rows, 1):
                print(f"{i}. {r['url']}")

        elif cmd == "add":
            for url in args:
                feed = feedparser.parse(url)
                if feed.entries or hasattr(feed.feed, 'title'):
                    self.query("INSERT OR IGNORE INTO rss_feeds (url) VALUES (?)", (url,))
                    print(f"Added: {url}")
                else:
                    print(f"Invalid or unparsable RSS feed: {url}")
            self.refresh_rss_list()

        elif cmd == "fetch" and len(parts) >= 3:
            try:
                num = int(args[0])
            except ValueError:
                print("Error: Fetch count must be an integer.")
                return
            
            ids = self.parse_feed_ids(" ".join(args[1:]))
            if not ids:
                print("No valid feed IDs specified.")
                return

            for fid in ids:
                f = self.query("SELECT * FROM rss_feeds WHERE id=?", (fid,)).fetchone()
                if not f: 
                    continue
                print(f"Fetching from: {f['url']}")
                try:
                    feed = feedparser.parse(f['url'])
                    for entry in feed.entries[:num]:
                        link = getattr(entry, 'link', None)
                        if link:
                            self.save_article(link, source_url=f['url'])
                except Exception as e:
                    print(f"  ! Error reading feed data: {e}")

        elif cmd == "-":
            self.delete_items("rss_feeds", " ".join(args))


    def do_read(self, arg):
        """Commands: read [list|NUM|*|show NUM|- NUM]"""
        parts = arg.split()
        if not parts:
            return
        
        first_arg = parts[0]
        is_implicit_id = (
            first_arg.isdigit() or 
            first_arg == "*" or 
            ('-' in first_arg and first_arg.replace('-', '').isdigit())
        )
        
        if is_implicit_id:
            cmd = "audio"
            args = parts
        else:
            cmd = first_arg
            args = parts[1:]
        
        if cmd == "list":
            rows = self.query("SELECT * FROM article ORDER BY publish_date ASC").fetchall()
            if not rows:
                print("No articles found.")
                return
            for i, row in enumerate(rows, 1):
                print(self.article_summary(row, i))
            return

        elif cmd in ["audio", "show"]:
            cleanup_after = parts[-1] == "-" if parts else False
            clean_args = " ".join(args[:-1]) if cleanup_after else " ".join(args)
                
            ids = self.parse_ids(clean_args)
            if not ids:
                print("No valid article IDs specified.")
                return

            for i, aid in enumerate(ids, 1):
                art = self.query("SELECT * FROM article WHERE id=?", (aid,)).fetchone()
                if not art: 
                    continue
                
                print(f"[{i}/{len(ids)}] {art['title']} (Close window to skip/next)")
                full_text = f"{art['title']}\n\n{art['content']}"
                
                tmp_path = None
                proc_yad = None
                proc_tts = None
                
                try:
                    proc_yad = subprocess.Popen([
                        "yad", "--text-info", "--title", art['title'], 
                        "--width=800", "--height=600", "--wrap", "--center"
                    ], stdin=subprocess.PIPE, text=True, stderr=subprocess.DEVNULL)
                    
                    try:
                        proc_yad.stdin.write(full_text)
                        proc_yad.stdin.close()
                    except (OSError, BrokenPipeError):
                        pass

                    if cmd == "audio":
                        import tempfile
                        with tempfile.NamedTemporaryFile(mode='w', delete=False, suffix='.txt', encoding='utf-8') as tf:
                            tf.write(full_text)
                            tmp_path = tf.name
                        
                        proc_tts = subprocess.Popen([TTS_SCRIPT, "-f", tmp_path], stderr=subprocess.DEVNULL)
                    
                    proc_yad.wait()

                except KeyboardInterrupt:
                    break
                finally:
                    if proc_tts and proc_tts.poll() is None:
                        proc_tts.terminate()
                        proc_tts.wait()
                        
                    if tmp_path and os.path.exists(tmp_path):
                        try:
                            os.remove(tmp_path)
                        except OSError:
                            pass
                            
                    if cleanup_after: 
                        self.query("DELETE FROM article WHERE id=?", (aid,))
            
            if cleanup_after:
                self.refresh_article_list()

        elif cmd == "-":
            self.delete_items("article", " ".join(args))


    def do_url(self, arg):
        """Commands: url add <URL>`"""
        parts = arg.split()
        if len(parts) < 2 or parts[0] != "add":
            return
        self.save_article(parts[1])

    def do_help(self, arg):
        """Shows custom help panels"""
        if arg:
            func_name = f"do_{arg.strip()}"
            if hasattr(self, func_name):
                doc = getattr(self, func_name).__doc__
                if doc:
                    print(doc.split('\n')[0])
                    return
            print(f"No help found for command: {arg}")
            return

        print("rss")
        print("read")
        print("url")
        print("help")
        print("exit")

    def do_exit(self, arg):
        """Exit the shell"""
        print("...")
        self.conn.close()
        return True

    def do_EOF(self, arg):
        """Handle Ctrl+D to exit"""
        return self.do_exit(arg)

if __name__ == '__main__':
    print("Welcome to Brief - CLI RSS News\nType 'help' or '?' for commands.\n")
    BriefShell().cmdloop()